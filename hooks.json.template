{
  "governance-monitor": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "{{SCRIPTS_DIR}}/governance_init.sh",
        "timeout": 15
      }
    ]
  },
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "{{SCRIPTS_DIR}}/safety_gate.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "session-close": {
    "Stop": [
      {
        "type": "command",
        "command": "{{SCRIPTS_DIR}}/session_close.sh",
        "timeout": 30
      }
    ]
  }
}
