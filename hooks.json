{
  "governance-monitor": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "~/.gemini/antigravity/scratch/ai-steering-rules/scripts/governance_init.sh",
        "timeout": 15
      }
    ]
  },
  "safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "~/.gemini/antigravity/scratch/ai-steering-rules/scripts/safety_gate.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "session-close": {
    "Stop": [
      {
        "type": "command",
        "command": "~/.gemini/antigravity/scratch/ai-steering-rules/scripts/session_close.sh",
        "timeout": 30
      }
    ]
  }
}
