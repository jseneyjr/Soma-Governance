__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/

# JavaScript artifacts
node_modules/

# Environment files (may contain API keys)
.env
.env.*

# OS metadata
.DS_Store
Thumbs.db

